# H2O PBE/def2-SVP all-electron (GAPW): triplet 5 -> 6 and the core pair 1 (O 1s) -> 6, K_if on the grid
&GLOBAL
  PRINT_LEVEL low
  PROJECT h2o_be_ae_gapw
  RUN_TYPE energy
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    MULTIPLICITY 3
    POTENTIAL_FILE_NAME POTENTIAL
    UKS .true.
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &QS
      METHOD GAPW
    &END QS
    &SCF
      ADDED_MOS 3
      EPS_SCF 1.0E-7
      MAX_SCF 50
      SCF_GUESS atomic
    &END SCF
    &XC
      &XC_FUNCTIONAL pbe
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BE_EXCITON
      METHOD GRID
      ORBITAL_PAIR 5 6
      ORBITAL_PAIR 1 6
    &END BE_EXCITON
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC NONE
    &END CELL
    &COORD
      O   0.000000    0.000000   -0.065587
      H   0.000000   -0.757136    0.520545
      H   0.000000    0.757136    0.520545
    &END COORD
    &KIND H
      BASIS_SET Ahlrichs-def2-SVP
      POTENTIAL ALL
    &END KIND
    &KIND O
      BASIS_SET Ahlrichs-def2-SVP
      POTENTIAL ALL
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
