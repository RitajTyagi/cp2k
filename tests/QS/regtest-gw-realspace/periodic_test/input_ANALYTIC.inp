&GLOBAL
  PRINT_LEVEL SILENT
  PROJECT RIRS-G0W0-PBE-KPOINT
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME REGTEST_BASIS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 500
      REL_CUTOFF 50
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1E-6
      MAX_SCF 500
      SCF_GUESS ATOMIC
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS 10
      &END GW
      &BANDSTRUCTURE_PATH
        SPECIAL_POINT A  0.0    0.0    0.0
      &END
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 6 6 6
      MULTIPLE_UNIT_CELL 1 1 1
      PERIODIC XYZ
    &END CELL
    &COORD
    O     1.5000    1.5000    1.5000
    H     2.2571    1.5000    2.0861
    H     0.7429    1.5000    2.0861
    O     4.5000    4.5000    1.5000
    H     4.5000    5.2571    2.0861
    H     4.5000    3.7429    2.0861
    O     1.5000    4.5000    4.5000
    H     2.0861    4.5000    5.2571
    H     2.0861    4.5000    3.7429
    O     4.5000    1.5000    4.5000
    H     5.2571    1.5000    5.0861
    H     3.7429    1.5000    5.0861
    &END COORD
    &KIND H
      BASIS_SET H_MINI
      BASIS_SET RI_AUX RI_H_MINI
      POTENTIAL ALL
    &END KIND
    &KIND O
      BASIS_SET O_MINI
      BASIS_SET RI_AUX RI_O_MINI
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
