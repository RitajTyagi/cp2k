! hbn: full-k RI-RS GW of PR 6447, primitive cell, 9x9 mesh, DZVP.
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      hbn_kp9
  PRINT_LEVEL  MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    BASIS_SET_FILE_NAME  BASIS_RI_MOLOPT
    POTENTIAL_FILE_NAME  POTENTIAL
    SORT_BASIS EXP
    &KPOINTS
      SCHEME MONKHORST-PACK 9 9 1
    &END KPOINTS
    &MGRID
      CUTOFF 500
      REL_CUTOFF 50
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-8
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      ADDED_MOS -1
      EPS_SCF 1.0E-7
      MAX_SCF 100
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 4
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC XY
      POISSON_SOLVER MT
    &END POISSON
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS      10
        EPS_FILTER           1.0E-10
        CUTOFF_RADIUS_RI           5
        SIZE_LATTICE_SUM           4
        &RI_RS
          TIKHONOV 1.0E-8
          &GRID_OPTIMIZATION
            RS_AO_RATIO 7
            MAX_ITER 300
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
      &DOS
        KPOINTS 9 9 1
      &END DOS
      &BANDSTRUCTURE_PATH
        NPOINTS 2
        SPECIAL_POINT GAMMA 0.0 0.0 0.0
        SPECIAL_POINT M 0.5 0.0 0.0
        SPECIAL_POINT K 0.3333333333333333 0.3333333333333333 0.0
      &END BANDSTRUCTURE_PATH
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      PERIODIC XY
      ABC  2.50223 2.50223 15.0
      ALPHA_BETA_GAMMA 90.0 90.0 120.0
    &END CELL
    &COORD
      SCALED
      B 0.0000000 0.0000000 0.5000000
      N 0.3333333 0.6666667 0.5000000
    &END COORD
    &KIND B
      BASIS_SET ORB DZVP-MOLOPT-SR-GTH
      BASIS_SET RI_AUX RI_20_4_2_2_0_0_0_0_2.7e-03
      POTENTIAL GTH-PBE-q3
    &END KIND
    &KIND N
      BASIS_SET ORB DZVP-MOLOPT-SR-GTH
      BASIS_SET RI_AUX RI_26_3_2_2_1_0_0_0_2.4e-03
      POTENTIAL GTH-PBE-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
