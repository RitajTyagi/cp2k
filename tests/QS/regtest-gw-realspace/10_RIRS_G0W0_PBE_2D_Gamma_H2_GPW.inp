&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT h2-2d-gamma-gpw
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    BASIS_SET_FILE_NAME REGTEST_BASIS
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SORT_BASIS EXP
    &MGRID
      CUTOFF 250
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC XY
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      EPS_EIGVAL 1.0E-12
      EPS_SCF 1.0E-9
      MAX_SCF 500
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.1
        BETA 1.5
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        ANALYTIC_CONTINUATION PADE
        EPS_FILTER 1.0E-4
        FREQ_MAX_FIT 27.211
        NUM_TIME_FREQ_POINTS 6
        REGULARIZATION_RI -1
        &RI_RS
          TIKHONOV 1.0E-8
          &GRID_OPTIMIZATION
            CUTOFF_ATOMIC_CLUSTER [angstrom] 1.5
            MAX_ITER 5
            RS_AO_RATIO 12
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 3.0 3.0 8.0
      ALPHA_BETA_GAMMA 90 90 120
      MULTIPLE_UNIT_CELL 2 2 1
      PERIODIC XY
    &END CELL
    &COORD
      H 0.0 0.0 4.0
      H 0.74 0.0 4.0
    &END COORD
    &KIND H
      BASIS_SET SZV-GTH
      BASIS_SET RI_AUX RI_H_MINI
      POTENTIAL GTH-PBE-q1
    &END KIND
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 2 2 1
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
