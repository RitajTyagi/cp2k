&GLOBAL
  PRINT_LEVEL SILENT
  PROJECT RIRS-G0W0-PBE-Gamma-CH4
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME REGTEST_BASIS
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SORT_BASIS EXP
    &MGRID
      CUTOFF 200
      REL_CUTOFF 30
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-6
      MAX_SCF 100
      SCF_GUESS ATOMIC
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &BANDSTRUCTURE_PATH
        SPECIAL_POINT GAMMA 0.0 0.0 0.0
      &END BANDSTRUCTURE_PATH
      &DOS
        KPOINTS 1 1 1
      &END DOS
      &GW
        ANALYTIC_CONTINUATION PADE
        FREQ_MAX_FIT 27.211
        NUM_TIME_FREQ_POINTS 10
        &RI_RS
          GRID_SELECT 1
        &END RI_RS
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC XYZ
    &END CELL
    &COORD
      C 3.0000 3.0000 3.0000
      H 3.6287 3.6287 3.6287
      H 3.6287 2.3713 2.3713
      H 2.3713 3.6287 2.3713
      H 2.3713 2.3713 3.6287
    &END COORD
    &KIND C
      BASIS_SET ORB SZV-MOLOPT-SR-GTH
      BASIS_SET RI_AUX RI_CH4_MINI
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND H
      BASIS_SET ORB SZV-MOLOPT-SR-GTH
      BASIS_SET RI_AUX RI_CH4_MINI
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
