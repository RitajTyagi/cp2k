! sic: Gamma-only RI-RS (KPOINTS_W 1 1 1 + head/wing correction), 9x9 supercell, DZVP.
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      sic_g9
  PRINT_LEVEL  MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    BASIS_SET_FILE_NAME  BASIS_RI_MOLOPT
    POTENTIAL_FILE_NAME  POTENTIAL
    &MGRID
      CUTOFF 500
      REL_CUTOFF 50
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-8
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 100
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 4
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC XY
      POISSON_SOLVER MT
    &END POISSON
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS      10
        EPS_FILTER           1.0E-10
        CUTOFF_RADIUS_RI           5
        KPOINTS_W              1 1 1
        SIZE_LATTICE_SUM           4
        &RI_RS
        &END
      &END GW
      &DOS
        KPOINTS 1 1 1
      &END DOS
      &BANDSTRUCTURE_PATH
        SPECIAL_POINT GAMMA 0.0 0.0 0.0
      &END
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      PERIODIC XY
      ABC  3.09000 3.09000 15.0
      ALPHA_BETA_GAMMA 90.0 90.0 120.0
      MULTIPLE_UNIT_CELL 9 9 1
    &END CELL
    &COORD
      SCALED
      Si 0.0000000 0.0000000 0.5000000
      C  0.3333333 0.6666667 0.5000000
    &END COORD
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 9 9 1
    &END TOPOLOGY
    &KIND Si
      BASIS_SET ORB DZVP-MOLOPT-SR-GTH
      BASIS_SET RI_AUX RI_26_3_2_2_1_0_0_0_1.6e-03
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND C
      BASIS_SET ORB DZVP-MOLOPT-SR-GTH
      BASIS_SET RI_AUX RI_26_3_2_2_1_0_0_0_2.7e-03
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
