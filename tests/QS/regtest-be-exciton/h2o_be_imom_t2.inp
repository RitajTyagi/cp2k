# H2O PBE: state-specific IMOM triplet 3 -> 5 (beta hole in 3) restarted from h2o_be_t1, BE exciton E_S
# E_GROUND_STATE: closed-shell PBE ground state in the same setup
&GLOBAL
  PRINT_LEVEL low
  PROJECT h2o_be_imom_t2
  RUN_TYPE energy
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    MULTIPLICITY 3
    POTENTIAL_FILE_NAME POTENTIAL
    UKS .true.
    WFN_RESTART_FILE_NAME h2o_be_t1-RESTART.wfn
    &MGRID
      CUTOFF 200
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &SCF
      ADDED_MOS 3
      EPS_SCF 1.0E-7
      MAX_SCF 50
      SCF_GUESS restart
      &MOM ON
        DEOCC_BETA 3
        MOM_TYPE IMOM
        OCC_BETA 4
      &END MOM
    &END SCF
    &XC
      &XC_FUNCTIONAL pbe
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BE_EXCITON
      E_GROUND_STATE -17.2637001007
      METHOD GRID
      ORBITAL_PAIR 3 5
    &END BE_EXCITON
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC NONE
    &END CELL
    &COORD
      O   0.000000    0.000000   -0.065587
      H   0.000000   -0.757136    0.520545
      H   0.000000    0.757136    0.520545
    &END COORD
    &KIND H
      BASIS_SET DZVP-GTH-PADE
      POTENTIAL GTH-PADE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-GTH-PADE
      POTENTIAL GTH-PADE-q6
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
